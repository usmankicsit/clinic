# Backend
# Local Docker/Postgres (used when DATABASE_URL is not set)
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=clinic
DATABASE_PASSWORD=clinic
DATABASE_NAME=clinic_pos

# Production (Neon / Render) — if set, overrides host/port/user/password/name above
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
PORT=3001
FRONTEND_URL=http://localhost:3000
SEED_ON_START=true

# Pusher (optional realtime online-order alerts)
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=mt1
